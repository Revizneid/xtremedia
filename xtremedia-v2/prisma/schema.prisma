generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum SongStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  salt         String?
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  playlists Playlist[]
  comments  Comment[]

  @@map("users")
}

model Artist {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  avatarUrl String?
  bio       String?
  country   String?  @default("VIETNAM")
  viewCount Int      @default(0)
  createdAt DateTime @default(now())

  songs  Song[]
  albums Album[]

  @@index([name])
  @@map("artists")
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  songs Song[]

  @@index([name])
  @@map("genres")
}

model Album {
  id          String   @id @default(cuid())
  title       String
  artistId    String
  coverUrl    String?
  description String?
  createdAt   DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs  Song[]

  @@index([artistId, title])
  @@map("albums")
}

model Song {
  id            String     @id @default(cuid())
  videoId       String?    @unique
  title         String
  titleAscii    String
  slug          String
  artistId      String
  genreId       String?
  albumId       String?
  durationSec   Int
  audioUrl      String
  coverUrl      String?
  thumbnailUrl  String?
  sourceUrl     String?
  trimStart     Int        @default(0)
  trimEnd       Int        @default(0)
  playCount     Int        @default(0)
  downloadCount Int        @default(0)
  isBroken      Boolean    @default(false)
  status        SongStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  artist      Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre       Genre?        @relation(fields: [genreId], references: [id], onDelete: SetNull)
  album       Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)
  heroBanners HeroBanner[]  @relation("HeroBannerSong")

  playlistSongs PlaylistSong[]
  comments      Comment[]

  @@unique([videoId, trimStart, trimEnd])
  @@index([title, artistId])
  @@index([createdAt])
  @@map("songs")
}

model HeroBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  songId    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song? @relation("HeroBannerSong", fields: [songId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@map("hero_banners")
}

model Playlist {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs PlaylistSong[]

  @@index([userId, createdAt])
  @@map("playlists")
}

model PlaylistSong {
  id         String   @id @default(cuid())
  playlistId String
  songId     String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([playlistId, position])
  @@map("playlist_songs")
}

model Comment {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([songId, createdAt])
  @@map("comments")
}

model SyncLog {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  payloadHash    String
  status         String
  error          String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("sync_logs")
}
